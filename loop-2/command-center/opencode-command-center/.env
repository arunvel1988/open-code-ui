# Dashboard login password - change before starting
DASHBOARD_PASSWORD=Admin123@#
FLASK_SECRET_KEY=replace-with-a-long-random-secret
# Keep private by default. Use SSH tunnel to access remotely.
BIND_IP=0.0.0.0
# Host project directory mounted into the app container at /workspace. Ensure it is writable by the Docker user.
HOST_PROJECT_DIR=./workspace
